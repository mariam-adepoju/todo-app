PORT=
MONGO_URI=
SESSION_SECRET=
NODE_ENV=

# JWT (used to authenticate the WebSocket connection)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Email - option 1: SMTP (e.g. Gmail app password, Mailtrap)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Email - option 2: Resend HTTP API (use this if your host blocks SMTP)
RESEND_API_KEY=
MAIL_FROM="Todo App <you@example.com>"
